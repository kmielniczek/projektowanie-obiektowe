#extend("base"):
    #export("content"):
        <div class="card">
            <h2>Orders</h2>
            #if(count(orders) > 0):
                <table>
                    <thead>
                        <tr><th>Customer</th><th>Date</th><th>Total</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        #for(order in orders):
                            <tr>
                                <td><a href="/orders/#(order.id)">#(order.customerName)</a></td>
                                <td>#(order.createdAt)</td>
                                <td>#(order.totalFormatted) PLN</td>
                                <td class="actions">
                                    <a class="btn btn-secondary" href="/orders/#(order.id)/edit">Edit</a>
                                    <form class="inline" method="post" action="/orders/#(order.id)/delete">
                                        <input type="submit" class="btn btn-danger" value="Delete">
                                    </form>
                                </td>
                            </tr>
                        #endfor
                    </tbody>
                </table>
            #else:
                <p>No orders yet.</p>
            #endif
        </div>
    #endexport
#endextend
